{
  "version": 2,
  "installCommand": "npm --prefix mcp-server ci",
  "buildCommand": "npm run mcp:bundle",
  "outputDirectory": "public",
  "functions": {
    "api/mcp.mjs": {
      "includeFiles": "skills/**",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ]
}
