{
  "name": "shopify-app-builder",
  "version": "1.3.0",
  "description": "31 open-source Shopify app development skills for Claude Code, Codex, Cursor, OpenCode, Command Code, and other AI coding agents.",
  "type": "module",
  "bin": {
    "shopify-app-builder": "./scripts/install-agent-skills.mjs"
  },
  "files": [
    ".claude-plugin",
    ".codex-plugin",
    "agents",
    "assets",
    "commands",
    "docs",
    "scripts",
    "skills",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "PRIVACY.md",
    "README.md",
    "SECURITY.md",
    "TERMS.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-release.mjs",
    "release:check": "npm test && npm run validate",
    "prepack": "npm run release:check"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "shopify",
    "shopify-app",
    "shopify-development",
    "agent-skills",
    "ai-coding-agent",
    "claude-code",
    "codex",
    "cursor",
    "opencode",
    "command-code",
    "graphql",
    "app-bridge",
    "polaris",
    "webhooks"
  ],
  "author": "Shopify App Builder Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khadinakbarlabs/shopify-app-builder.git"
  },
  "bugs": {
    "url": "https://github.com/khadinakbarlabs/shopify-app-builder/issues"
  },
  "homepage": "https://github.com/khadinakbarlabs/shopify-app-builder#readme",
  "publishConfig": {
    "access": "public"
  }
}
