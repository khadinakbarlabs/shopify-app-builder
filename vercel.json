{
  "version": 2,
  "installCommand": "npm ci",
  "functions": {
    "api/mcp.mjs": {
      "includeFiles": "skills/**",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/.well-known/openai-apps-challenge",
      "destination": "/api/openai-apps-challenge"
    }
  ]
}
