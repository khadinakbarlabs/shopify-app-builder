{
  "name": "shopify-app-builder",
  "version": "1.5.9",
  "description": "Open-source Shopify app development guidance for AI coding agents, with a read-only MCP server and native agent plugins.",
  "type": "module",
  "main": ".opencode/plugins/shopify-app-builder.js",
  "bin": {
    "shopify-app-builder": "scripts/install-agent-skills.mjs"
  },
  "files": [
    ".agents",
    ".claude-plugin",
    ".codex",
    ".codex-plugin",
    ".cursor-plugin",
    ".opencode",
    "api",
    "agents",
    "assets",
    "commands",
    "docs",
    "mcp-server",
    "mcp.json",
    ".mcp.json",
    "scripts",
    "skills",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "GEMINI.md",
    "LICENSE",
    "PRIVACY.md",
    "plugin.json",
    "README.md",
    "SECURITY.md",
    "TERMS.md",
    "vercel.json",
    "gemini-extension.json"
  ],
  "scripts": {
    "mcp:start": "npm --prefix mcp-server run start",
    "mcp:test": "npm --prefix mcp-server test",
    "mcp:bundle": "mcp-server/node_modules/.bin/esbuild api/_mcp-entry.mjs --bundle --platform=node --format=cjs --outfile=api/_mcp-bundle.cjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-release.mjs",
    "release:check": "npm test && npm run mcp:test && npm run validate",
    "prepack": "npm run release:check"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "shopify",
    "shopify-app",
    "shopify-development",
    "agent-skills",
    "ai-coding-agent",
    "claude-code",
    "codex",
    "cursor",
    "opencode",
    "command-code",
    "graphql",
    "app-bridge",
    "polaris",
    "webhooks"
  ],
  "author": "Shopify App Builder Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khadinakbarlabs/shopify-app-builder.git"
  },
  "bugs": {
    "url": "https://github.com/khadinakbarlabs/shopify-app-builder/issues"
  },
  "homepage": "https://github.com/khadinakbarlabs/shopify-app-builder#readme",
  "publishConfig": {
    "access": "public"
  }
}
